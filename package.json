{
  "name": "cosmic-shooter",
  "version": "1.0.0",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy:testnet": "npx hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network base",
    "verify:testnet": "npx hardhat verify --network baseSepolia",
    "verify:mainnet": "npx hardhat verify --network base",
    "test": "npx hardhat test",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  }
}