# ── Smart Contract Deployment ──────────────────────────────────────
# Your deployer wallet private key (WITHOUT 0x prefix)
PRIVATE_KEY=c7dd3a387b29503ad77d625c57e10ffbafb600ba4e53f06a98acfe178be3fe61

# Base RPC URLs
# Used for deployment. BASE_RPC_URL is for mainnet, BASE_SEPOLIA_RPC_URL is for Sepolia testnet.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# BaseScan API key for contract verification (get free at https://basescan.org/myapikey)
BASESCAN_API_KEY=your_basescan_api_key_here

# ── Frontend (copy to frontend/.env.local) ──────────────────────────
# After deploying the contract, paste the address here:
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_YOUR_CONTRACT_ADDRESS_HERE

# Base App verification meta tag value
NEXT_PUBLIC_BASE_APP_ID=69fc5dc94a40e072f8ead7d2
